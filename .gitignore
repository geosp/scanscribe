# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Book inputs and OCR outputs stay local: they are often copyrighted.
in/
out/
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp
!tests/fixtures/**

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Agent tooling: local, per-user settings and session data
.claude/settings.local.json
.claude/*.local.*

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Scratch output from the github-pr skill
pr-description.md
